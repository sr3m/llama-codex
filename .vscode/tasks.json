{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Codex: Run switch tests",
      "type": "process",
      "command": "python3",
      "args": [
        "tests/run.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Extension: Install development dependencies",
      "type": "process",
      "command": "npm",
      "args": [
        "ci",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ],
      "options": {
        "cwd": "${workspaceFolder}/vscode-extension"
      },
      "problemMatcher": []
    },
    {
      "label": "Extension: Run unit tests",
      "type": "process",
      "command": "npm",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/vscode-extension"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Extension: Test in isolated VS Code",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "test:editor"
      ],
      "options": {
        "cwd": "${workspaceFolder}/vscode-extension"
      },
      "problemMatcher": []
    },
    {
      "label": "Extension: Build VSIX",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "package"
      ],
      "options": {
        "cwd": "${workspaceFolder}/vscode-extension"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
